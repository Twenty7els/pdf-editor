    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
